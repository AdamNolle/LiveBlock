# xcodegen output (regenerated from project.yml)
LiveBlock.xcodeproj/
# Finder duplicate-paste artifacts ("LiveBlock 2.xcodeproj", "LiveBlock 3.xcodeproj"…).
# Confuses xcodebuild and TCC; run.sh refuses to build until they're removed.
LiveBlock *.xcodeproj/
# Same hazard for plist/source duplicates ("Info 2.plist", "Foo 2.swift").
* [0-9].plist
* [0-9].swift

