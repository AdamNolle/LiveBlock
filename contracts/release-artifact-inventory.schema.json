{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://liveblock.local/contracts/release-artifact-inventory.schema.json",
  "title": "LiveBlock release artifact inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "hashAlgorithm",
    "platform",
    "artifactType",
    "commit",
    "requiredPaths",
    "entries",
    "aggregateSha256"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "hashAlgorithm": { "const": "sha256-release-inventory-v1" },
    "platform": { "type": "string", "minLength": 1 },
    "artifactType": { "type": "string", "minLength": 1 },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "requiredPaths": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/path" }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "type", "mode"],
            "properties": {
              "path": { "$ref": "#/$defs/path" },
              "type": { "const": "directory" },
              "mode": { "$ref": "#/$defs/mode" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "type", "mode", "size", "sha256"],
            "properties": {
              "path": { "$ref": "#/$defs/path" },
              "type": { "const": "file" },
              "mode": { "$ref": "#/$defs/mode" },
              "size": { "type": "integer", "minimum": 0 },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          }
        ]
      }
    },
    "aggregateSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\)(?!.*\/$).+$"
    },
    "mode": { "type": "string", "pattern": "^[0-7]{4}$" }
  }
}
