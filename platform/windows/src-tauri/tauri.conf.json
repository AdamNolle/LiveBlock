{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LiveBlock",
  "version": "0.1.0",
  "identifier": "com.adamnolle.LiveBlock",
  "build": {
    "beforeDevCommand": "cd ../../_shared-frontend && npm install && npm run dev",
    "beforeBuildCommand": "cd ../../_shared-frontend && npm ci && npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../../_shared-frontend/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "trayIcon": {
      "iconPath": "icons/icon.ico",
      "iconAsTemplate": false,
      "title": "LiveBlock",
      "tooltip": "LiveBlock"
    },
    "windows": [
      {
        "label": "control",
        "title": "LiveBlock",
        "url": "control-panel.html",
        "width": 380,
        "height": 540,
        "minWidth": 360,
        "minHeight": 480,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "visible": true,
        "center": true
      },
      {
        "label": "editor",
        "title": "LiveBlock — Region Editor",
        "url": "region-editor.html",
        "fullscreen": false,
        "width": 1280,
        "height": 800,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "resizable": true,
        "shadow": false
      },
      {
        "label": "render",
        "title": "LiveBlock Overlay",
        "url": "render-layer.html",
        "width": 1280,
        "height": 800,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "resizable": true,
        "shadow": false,
        "focus": false
      },
      {
        "label": "labeling",
        "title": "LiveBlock — Labeling",
        "url": "labeling.html",
        "width": 1100,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "visible": false,
        "center": true
      },
      {
        "label": "training",
        "title": "LiveBlock — Training",
        "url": "training.html",
        "width": 820,
        "height": 640,
        "minWidth": 640,
        "minHeight": 520,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": ["resources/*"],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "allowDowngrades": false,
      "wix": {
        "language": "en-US"
      }
    }
  }
}
